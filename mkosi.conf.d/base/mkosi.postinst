#!/bin/bash
# Stamp the version into os-release. mkosi adds IMAGE_ID and IMAGE_VERSION
# itself; VERSION, VERSION_ID, PRETTY_NAME and BUILD_ID are derived here.
# SYSEXT_LEVEL: a system extension (xctl extensions) only fits this exact version.
set -euo pipefail

version=${IMAGE_VERSION:?}
cat >>"$BUILDROOT/usr/lib/os-release" <<EOS
VERSION="$version"
VERSION_ID="${version%%-*}"
PRETTY_NAME="XeeonOS $version"
BUILD_ID="$(date -u +%Y%m%d)"
SYSEXT_LEVEL="$version"
EOS

# The Arch Linux snapshot the packages come from (shown by `xctl status`).
snapshot=$(sed -n 's/^Snapshot=//p' "$SRCDIR/mkosi.conf")
echo "XEEONOS_ARCH_SNAPSHOT=\"$snapshot\"" >>"$BUILDROOT/usr/lib/os-release"

# Keep a copy of the package database for mkosi.finalize, which writes the
# list of packages: mkosi removes pacman and the database before it runs.
rm -rf "$BUILDROOT/var/tmp/xeeonos-pkgdb"
cp -a "$BUILDROOT/var/lib/pacman/local" "$BUILDROOT/var/tmp/xeeonos-pkgdb"
