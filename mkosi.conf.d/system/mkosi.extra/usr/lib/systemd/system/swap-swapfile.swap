# The swap file, after zram (higher priority wins): the disk is used only
# when compressed memory is full. Created by xeeonos-swapfile.service.
[Unit]
Description=Swap file (reserve behind zram)
Requires=xeeonos-swapfile.service
After=xeeonos-swapfile.service

[Swap]
What=/swap/swapfile
Priority=10

[Install]
WantedBy=swap.target
