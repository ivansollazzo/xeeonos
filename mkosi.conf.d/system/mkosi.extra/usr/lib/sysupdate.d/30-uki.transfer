# The kernel goes last: a version only becomes bootable once its /usr is in place.
# It is installed with a boot counter (xeeonos_<v>+3-0.efi): 3 attempts to
# start; if all fail, systemd-boot goes back to the previous version.
[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/cache/xctl/update
MatchPattern=xeeonos_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=xeeonos_@v+@l-@d.efi \
             xeeonos_@v+@l.efi \
             xeeonos_@v.efi
TriesLeft=3
TriesDone=0
Mode=0644
InstancesMax=2
