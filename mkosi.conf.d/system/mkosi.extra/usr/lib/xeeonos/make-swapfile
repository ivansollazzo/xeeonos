#!/bin/sh
# The swap file: as large as the RAM, so that the computer can hibernate
# (the memory is written into it). Btrfs needs it in its own subvolume (no
# copy-on-write, no compression); being a subvolume, it is also left out of
# the snapshots of the data.
set -e
[ -d /swap ] || btrfs subvolume create /swap
mib=$(awk '/^MemTotal:/ { print int(($2 + 1023) / 1024) }' /proc/meminfo)
btrfs filesystem mkswapfile --size "${mib}m" /swap/swapfile.new
mv /swap/swapfile.new /swap/swapfile
