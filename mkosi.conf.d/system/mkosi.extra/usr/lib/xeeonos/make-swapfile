#!/bin/sh
# The swap file: as large as the RAM, so that the computer can hibernate
# (the memory is written into it), but at most a quarter of the data
# partition, so that a small disk keeps room for files and updates. (The
# hibernation image is compressed and holds only the memory in use, so a
# smaller file is usually still enough.) Btrfs needs it in its own subvolume
# (no copy-on-write, no compression); being a subvolume, it is also left out
# of the snapshots of the data.
set -e
[ -d /swap ] || btrfs subvolume create /swap
ram=$(awk '/^MemTotal:/ { print int(($2 + 1023) / 1024) }' /proc/meminfo)
quarter=$(df --block-size=1M --output=size / | awk 'NR == 2 { print int($1 / 4) }')
mib=$(( ram < quarter ? ram : quarter ))
btrfs filesystem mkswapfile --size "${mib}m" /swap/swapfile.new
mv /swap/swapfile.new /swap/swapfile
