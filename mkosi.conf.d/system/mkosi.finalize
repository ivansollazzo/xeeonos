#!/bin/bash
# Keep a pristine copy of the build's /etc inside /usr ("factory" defaults).
# At boot, systemd-tmpfiles links the files the system needs from there into
# the real /etc (see usr/lib/tmpfiles.d/etc.conf), so a new /usr brings new
# defaults with it, and anything the administrator writes in /etc wins.
set -euo pipefail

mkdir -p "$BUILDROOT/usr/share/factory"
cp --archive --no-target-directory --update=none \
    "$BUILDROOT/etc" "$BUILDROOT/usr/share/factory/etc"

# Services enabled at build time (presets) are symlinks in /etc/systemd. /etc
# is not part of the image, so move them into /usr: on XeeonOS the vendor
# decides what runs by default, and the administrator can still override it
# in /etc (e.g. `systemctl disable` or `mask`).
for scope in system user; do
    src="$BUILDROOT/etc/systemd/$scope"
    dst="$BUILDROOT/usr/lib/systemd/$scope"
    [[ -d $src ]] || continue
    (cd "$src" && find . -type l) | while read -r link; do
        mkdir -p "$dst/$(dirname "$link")"
        [[ -e $dst/$link || -L $dst/$link ]] || cp --no-dereference "$src/$link" "$dst/$link"
    done
done
