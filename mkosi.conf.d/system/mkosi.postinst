#!/bin/bash
# Prepare the image for a hermetic /usr: everything the OS needs must live in
# /usr, because /etc and /var are not part of the image (they live on the data
# partition, created empty at first boot).
set -euo pipefail

# tmpfiles snippets from Arch packages that expect a fully populated /etc.
rm -f "$BUILDROOT"/usr/lib/tmpfiles.d/{arch,audit,openssh}.conf
