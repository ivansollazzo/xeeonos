#!/bin/bash
# Names like printer.local (how network printers announce themselves) are
# resolved through Avahi.
set -euo pipefail
sed -i 's/^hosts: mymachines /&mdns_minimal [NOTFOUND=return] /' "$BUILDROOT/etc/nsswitch.conf"
grep -q '^hosts:.*mdns_minimal' "$BUILDROOT/etc/nsswitch.conf" ||
    { echo "printing: the hosts line of nsswitch.conf has changed" >&2; exit 1; }
